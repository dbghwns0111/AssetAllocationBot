# .env 로 복사해서 값 수정 (.env 는 git 에 올라가지 않음)
# 아래 값은 클라우드 PC(서버) 기준. 개발 PC 에서는 .env 없이 실행해도 127.0.0.1:5001 로 뜬다.

# ── 웹 서버 ───────────────────────────────────────────────────────────────
# 0.0.0.0 = ZeroTier 로 휴대폰/집 PC 에서 접속 허용. (서버 내부에서만 쓰려면 127.0.0.1)
HAA_HOST=0.0.0.0
# CryptoSplit 이 5000 을 쓰므로 5001
HAA_PORT=5001

# ── 접근 보안 ─────────────────────────────────────────────────────────────
# 비밀번호 (비워두면 로그인 없이 접속됨 — 외부 접속 시 반드시 설정)
WEB_PASSWORD=
# 세션 서명 키 (비워두면 재시작할 때마다 다시 로그인). 아무 긴 랜덤 문자열
WEB_SECRET_KEY=
# 접속 허용 IP/대역 (쉼표 구분, 비우면 전체 허용, 127.0.0.1 은 항상 허용)
WEB_IP_WHITELIST=10.73.56.0/24

# ── 텔레그램 (자산배분 전용 봇 — CryptoSplit 봇과 다른 토큰) ────────────────────
# BotFather 에서 새 봇 생성 → 토큰. 봇에게 아무 메시지 보낸 뒤 채팅 ID 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 기타 (선택) ───────────────────────────────────────────────────────────
# DB_PATH=data/haa.db
# LOG_LEVEL=INFO
